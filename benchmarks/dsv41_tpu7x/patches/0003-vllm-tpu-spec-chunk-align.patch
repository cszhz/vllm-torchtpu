From afbcce3152df0faf818fb37565c47a8740646cba Mon Sep 17 00:00:00 2001
From: Chaitanya Kulkarni <chaitanyapk@google.com>
Date: Mon, 26 Oct 2026 16:29:37 +0000
Subject: [PATCH] fix(sched): align TPU intermediate chunked prefill splits to
 64-token KV blocks under spec decode

---
 vllm/v1/core/sched/scheduler.py | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/core/sched/scheduler.py b/vllm/v1/core/sched/scheduler.py
index fbe81a3b51..de16b3ff12 100644
--- a/vllm/v1/core/sched/scheduler.py
+++ b/vllm/v1/core/sched/scheduler.py
@@ -32,6 +32,7 @@ from vllm.logger import init_logger
 from vllm.multimodal import MULTIMODAL_REGISTRY, MultiModalRegistry
 from vllm.multimodal.encoder_budget import MultiModalBudget
 from vllm.multimodal.utils import get_mm_features_in_window
+from vllm.platforms import current_platform
 from vllm.utils.math_utils import cdiv
 from vllm.v1.core.encoder_cache_manager import (
     EncoderCacheManager,
@@ -643,7 +644,12 @@ class Scheduler(SchedulerInterface):
         num_scheduled_tokens: dict[str, int] = {}
         token_budget = self.max_num_scheduled_tokens
         spec = self.vllm_config.speculative_config
-        draft_slots = spec.max_num_new_slots_for_drafting if spec is not None else 0
+        is_tpu_platform = current_platform.device_type == "tpu"
+        draft_slots = (
+            0
+            if is_tpu_platform
+            else (spec.max_num_new_slots_for_drafting if spec is not None else 0)
+        )
         input_budget = self.scheduler_config.max_num_batched_tokens
         if self._pause_state == PauseState.PAUSED_ALL:
             # Do not schedule any requests when paused.
@@ -750,6 +756,16 @@ class Scheduler(SchedulerInterface):
                 num_new_tokens = self._mamba_block_aligned_split(
                     request, num_new_tokens
                 )
+            elif (
+                is_tpu_platform
+                and request.num_computed_tokens + num_new_tokens
+                < request.num_prompt_tokens
+            ):
+                aligned_end = (
+                    (request.num_computed_tokens + num_new_tokens) // 64
+                ) * 64
+                if aligned_end > request.num_computed_tokens:
+                    num_new_tokens = aligned_end - request.num_computed_tokens
 
             # Schedule encoder inputs.
             encoder_inputs_to_schedule = None
@@ -1211,6 +1227,16 @@ class Scheduler(SchedulerInterface):
                             # so drop the padding instead of shortening it.
                             num_new_tokens = 1
                             pad_spec_decode = False
+                    elif (
+                        is_tpu_platform
+                        and num_computed_tokens + num_new_tokens
+                        < request.num_prompt_tokens
+                    ):
+                        aligned_end = (
+                            (num_computed_tokens + num_new_tokens) // 64
+                        ) * 64
+                        if aligned_end > num_computed_tokens:
+                            num_new_tokens = aligned_end - num_computed_tokens
 
                     # Schedule encoder inputs.
                     if request.has_encoder_inputs:
-- 
