+# Opt-in: tokenize text prompts of at least this many characters as independent
+# pieces in one Rust `encode_batch` call (GIL released, pieces run on the
+# tokenizers thread pool). 0 disables.
+_SPLIT_TOKENIZE_MIN_CHARS = int(os.getenv("VLLM_SPLIT_TOKENIZE_MIN_CHARS", "0"))
+_SPLIT_TOKENIZE_PIECES = int(os.getenv("VLLM_SPLIT_TOKENIZE_PIECES", "16"))
+
+
+def _split_tokenize(tokenizer: Any, text: str, kwargs: dict[str, Any]) -> list[int] | None:
+    """Token ids of `text` computed piecewise, or None to use the normal path.
+
+    Pieces are cut only at i with text[i] == " ", text[i - 1] not whitespace and
+    text[i + 1] a letter. For byte-level BPE with an empty normalizer and a
+    GPT/DeepSeek-style regex pre-tokenizer, every pre-token match that touches
+    such a space starts at it (letter runs exclude spaces; " ?[punct]+" and
+    " ?letters" take a space only as a prefix; whitespace runs start at the first
+    whitespace), so the cut is a pre-token boundary in any context and BPE never
+    merges across it. Validated bit-exact against one-shot encode on random and
+    natural text with the DeepSeek-V4.1 tokenizer. Opt in per model.
+    """
+    if _SPLIT_TOKENIZE_MIN_CHARS <= 0 or len(text) < _SPLIT_TOKENIZE_MIN_CHARS:
+        return None
+    backend = getattr(tokenizer, "_tokenizer", None)
+    if backend is None or not hasattr(backend, "encode_batch"):
+        return None
+    if getattr(backend, "padding", None) is not None:
+        return None
+    if kwargs.get("add_special_tokens", True) and tokenizer.num_special_tokens_to_add():
+        return None
+    n = len(text)
+    cuts = [0]
+    for k in range(1, _SPLIT_TOKENIZE_PIECES):
+        i = max(cuts[-1] + 1, k * n // _SPLIT_TOKENIZE_PIECES)
+        end = min(n - 1, i + 65536)
+        while i < end and not (
+            text[i] == " " and not text[i - 1].isspace() and text[i + 1].isalpha()
+        ):
+            i += 1
+        if i < end:
+            cuts.append(i)
+    cuts.append(n)
+    ids: list[int] = []
+    pieces = [text[a:b] for a, b in zip(cuts[:-1], cuts[1:])]
+    for enc in backend.encode_batch(pieces, add_special_tokens=False):
+        ids.extend(enc.ids)
+    max_length = kwargs.get("max_length")
+    if kwargs.get("truncation") and max_length is not None and len(ids) > max_length:
+        if getattr(tokenizer, "truncation_side", "right") == "left":
+            ids = ids[-max_length:]
+        else:
+            ids = ids[:max_length]
+    return ids
+
 
